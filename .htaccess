# ── BRUT — Apache/cPanel config ─────────────────────────────
Options -Indexes +FollowSymLinks

# Clean URLs: no .html extension
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 301 redirect /page.html -> /page
  RewriteCond %{THE_REQUEST} \s/+([^.\s?]+)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # Serve /page from /page.html
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# Long cache for static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png      "access plus 1 month"
  ExpiresByType image/jpeg     "access plus 1 month"
  ExpiresByType image/svg+xml  "access plus 1 month"
  ExpiresByType image/x-icon   "access plus 1 month"
  ExpiresByType text/css       "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType font/ttf       "access plus 1 year"
  ExpiresByType font/otf       "access plus 1 year"
</IfModule>

ErrorDocument 404 /index.html

# ── Block dev / meta files (when repo root is the web root) ──
RedirectMatch 404 ^/\.git
RedirectMatch 404 ^/(\.claude|tools|assets_src|node_modules)(/|$)
<FilesMatch "(^\.|\.(yml|md|gitignore|json|lock)$)">
  Require all denied
</FilesMatch>
